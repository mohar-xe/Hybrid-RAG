# Copy to `.env` and fill in the REQUIRED values. Nested settings use the
# `GROUP__FIELD` form (double underscore). Unknown keys are ignored.

# --- LLM generator: OpenAI-compatible endpoint [REQUIRED] ---
# Default: OpenRouter (set GENERATOR__BACKEND=ollama for local)
# Fast models: deepseek/deepseek-v4-flash (cheapest), stepfun/step-3.7-flash (fastest)
# Google Gemini (direct): GENERATOR__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai + model=gemini-2.0-flash-001
GENERATOR__BASE_URL=https://openrouter.ai/api/v1
GENERATOR__MODEL=deepseek/deepseek-v4-flash
GENERATOR__API_KEY=

# --- PostgreSQL + pgvector [REQUIRED] ---
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__DB_NAME=hybrid_rag
DATABASE__USER=postgres
DATABASE__PASSWORD=

# --- Embeddings ---
# Backend: api (default), ollama, or sentence_transformers
# When api: uses EMBEDDING__API_BASE_URL/MODEL/KEY (e.g. Mistral)
# Fallback: ollama by default
# EMBEDDING__BACKEND=api
# EMBEDDING__API_BASE_URL=https://api.mistral.ai/v1
# EMBEDDING__API_MODEL=mistral-embed
# EMBEDDING__API_KEY=
# EMBEDDING__BATCH_SIZE=128
# EMBEDDING__API_RATE_LIMIT=1

# --- Graph / Kùzu (optional; defaults shown) ---
# GRAPH__DB_PATH=data/kuzu_db
# GRAPH__MERGE_SIMILARITY_THRESHOLD=0.90

# --- KG entity-extraction: remote API (default: Gemini via OpenAI-compatible) ---
# Bundles NER__BATCH_SIZE chunks per call, rate-limited to NER__API_RATE_LIMIT RPM.
# Set EXTRACTION__BACKEND=local to use the Ollama fine-tuned model instead.
NER__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
NER__MODEL=gemini-3.6-flash
NER__API_KEY=
NER__BATCH_SIZE=30
NER__API_RATE_LIMIT=5
NER__DISABLE_THINKING=true
# NER__TEMPERATURE=0.0
# NER__TIMEOUT=120.0
# NER__MIN_TRIPLETS=3
# NER__MAX_TRIPLETS=8

# --- KG entity-extraction (local finetuned model, Ollama fallback) ---
# Used when EXTRACTION__BACKEND=local.
# EXTRACTION__BASE_URL=http://localhost:11434
# EXTRACTION__MODEL=hgr-triplet:q4
# EXTRACTION__TEMPERATURE=0.0
# EXTRACTION__TIMEOUT=120.0

# --- Document metadata extraction (Gemini 3.6 Flash, for document-level clustering) ---
# Extracted at ingest time: title, summary, synthetic questions, doc_type,
# topic_tags, entities, version_info, content_date.
# Falls back to spaCy local extraction when API is unavailable or doc > 1M chars.
# METADATA__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# METADATA__MODEL=gemini-3.6-flash
# METADATA__API_KEY=               # optional — falls back to NER__API_KEY
# METADATA__MAX_DOC_CHARS=1000000  # 1M chars; docs above this use spaCy fallback
# METADATA__NUM_QUESTIONS=8
# METADATA__TIMEOUT=120.0
# METADATA__BACKEND=api             # "api" (Gemini) or "local" (spaCy)
# METADATA__FALLBACK_ENABLED=true
# METADATA__FALLBACK_BACKEND=local

# --- Query understanding (Flash-Lite, at query time) ---
# Translates natural language questions into semantic_query + structured filters.
# QUERY__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# QUERY__MODEL=gemini-2.0-flash-lite
# QUERY__API_KEY=                   # falls back to METADATA__API_KEY → NER__API_KEY
# QUERY__TIMEOUT=10.0
# QUERY__TEMPERATURE=0.0

# --- Reranker ---
# Backend: api (default), ollama, or hf
# When api: uses RERANKER__API_BASE_URL/MODEL/KEY
# RERANKER__BACKEND=api
# RERANKER__API_BASE_URL=https://api.mistral.ai/v1
# RERANKER__API_MODEL=mistral-large-latest
# RERANKER__API_KEY=
# RERANKER__API_RATE_LIMIT=1
# RERANKER__TOP_K=5

# --- Faithfulness verifier (optional; off by default) ---
# Enable with VERIFIER__ENABLED=true.
# Backend: api (default), ollama, or hf
# VERIFIER__ENABLED=false
# VERIFIER__API_BASE_URL=https://openrouter.ai/api/v1
# VERIFIER__API_MODEL=google/gemini-3.6-flash
# VERIFIER__API_KEY=

# --- FastAPI surface ---
# API__KEY gates every endpoint; leave empty only for trusted local use.
# API__INGEST_DIR=data
API__API_KEY=

# --- HuggingFace (optional) ---
# Token used by `./setup.sh --local` for faster downloads.
# HF_TOKEN=
