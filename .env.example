# Copy to `.env` and fill in the REQUIRED values. Nested settings use the
# `GROUP__FIELD` form (double underscore). Unknown keys are ignored.

# --- LLM generator: OpenAI-compatible endpoint [REQUIRED] ---
# NOTE: the old flat `GENERATION_API_KEY` is no longer read — use GENERATOR__API_KEY.
GENERATOR__BASE_URL=https://api.deepseek.com
GENERATOR__MODEL=deepseek-v4-flash
GENERATOR__API_KEY=

# --- PostgreSQL + pgvector [REQUIRED] ---
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__DB_NAME=hybrid_rag
DATABASE__USER=postgres
DATABASE__PASSWORD=

# --- Embeddings (optional; defaults shown) ---
# EMBEDDING__MODEL=nomic-embed-text
# EMBEDDING__EMBED_DIM=256
# EMBEDDING__BATCH_SIZE=128

# --- Graph / Kùzu (optional; defaults shown) ---
# GRAPH__DB_PATH=data/kuzu_db
# GRAPH__MERGE_SIMILARITY_THRESHOLD=0.90   # cosine >= this => node-merge candidate
# GRAPH__MIN_RELATION_WEIGHT=0.50          # relations with weight <= this are not retrieved

# --- Context assembly (optional; defaults shown) ---
# CONTEXT__MAX_TOKENS=3000     # approx token budget for retrieved chunks + graph facts
# CONTEXT__TOKEN_RATIO=1.3     # words -> approx tokens multiplier (no tokenizer needed)

# --- FastAPI surface ---
# API_KEY gates every endpoint (sent as the `X-API-Key` header). REQUIRED before
# exposing the API to an untrusted network; if empty the app runs unauthenticated
# and logs a startup warning. INGEST_DIR is the allow-listed root for /ingest file
# paths (requests outside it are rejected) — defaults to the project `data/` dir.
API__API_KEY=
# API__INGEST_DIR=data

# --- Faithfulness verifier (optional; off by default) ---
# Enable to populate `faithfulness` on /query responses via an NLI cross-encoder.
# Heavy model + extra latency per request, so opt in explicitly.
# VERIFIER__ENABLED=false
# VERIFIER__MODEL=cross-encoder/nli-deberta-v3-base
# VERIFIER__THRESHOLD=0.6

# --- KG entity-extraction: which backend `ingest` uses to extract triplets ---
#   deepseek -> remote OpenAI-compatible API (DeepSeek V4 Flash)  [DEFAULT]
#   local    -> local Ollama-hosted fine-tuned model
# The CLI flag `--extractor/-e` (or POST /ingest?extractor=) overrides this per run.
# EXTRACTION__BACKEND=deepseek

# --- NER: remote entity-extraction, OpenAI-compatible (default DeepSeek V4 Flash) ---
# REQUIRED when the "deepseek" backend is used (the default). Treat this as a secret.
NER__API_KEY=
# NER__BASE_URL=https://api.deepseek.com
# NER__MODEL=deepseek-v4-flash
# NER__TEMPERATURE=0.0
# NER__TIMEOUT=120.0
# NER__CONCURRENCY=10          # parallel extraction requests (deepseek API parallelizes well)
# NER__DISABLE_THINKING=true   # disable reasoning/"thinking" mode (faster, avoids empty content)
# NER__MIN_TRIPLETS=3
# NER__MAX_TRIPLETS=8

# --- KG entity-extraction (local finetuned model, Ollama-native /api/chat) ---
# Used when EXTRACTION__BACKEND=local (or --extractor local). All optional.
# EXTRACTION__BASE_URL=http://localhost:11434
# EXTRACTION__MODEL=hgr-triplet:q4
# EXTRACTION__TEMPERATURE=0.0
# EXTRACTION__TIMEOUT=120.0
# EXTRACTION__NUM_CTX=4096
# EXTRACTION__CONCURRENCY=10   # parallel requests (Ollama may serialize on CPU)
# EXTRACTION__MIN_TRIPLETS=3
# EXTRACTION__MAX_TRIPLETS=8

# --- HuggingFace (optional) ---
# Token used by `./setup.sh --local` to download the fine-tuned GGUF
# (mohar07/qwen3-0.6b-kg-triplets) faster / with higher rate limits. The repo is
# public so this is optional. Get one at https://huggingface.co/settings/tokens
# Not read by the app (settings ignore unknown keys) — only used by setup.sh.
# HF_TOKEN=
